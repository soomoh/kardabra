# Allowlist: ignore everything at the top level, then name what the repo
# holds. Anything new at the root (build output, scratch files, an editor's
# folder, the sandbox's masked dotfiles) stays out until it's listed here.
/*
!/.github/
!/.gitignore
!/.prettierignore
!/.prettierrc
!/.repo-visibility
!/LICENSE
!/README.md
!/THIRD_PARTY_NOTICES.md
!/eslint.config.js
!/index.html
!/package.json
!/package-lock.json
!/playwright.config.ts
!/playwright.visual.config.ts
!/public/
!/scripts/
!/src/
!/tests/
!/tsconfig.json
!/vite.config.ts

# Inside the allowed folders
node_modules/
*.tsbuildinfo
*.log
.env*
*.local
.DS_Store
*~
*.sw[po]
probe-out.json

# Statements are user financial data. Make committing one impossible by accident:
# ignore every statement-shaped file, then re-allow ONLY the synthetic test
# fixtures (fabricated data, real layout — see tests/fixtures/README).
# Formats the app can't even parse (.ofx, .qif) are ignored too: an
# unusable file is the one most likely to be dropped here and forgotten.
*.csv
*.xls
*.xlsx
*.xlsm
*.pdf
*.ofx
*.qif
!tests/fixtures/**
