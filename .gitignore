# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo
coverage/
*.log

# Secrets & environment
.env*
*.local
.dev.vars

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*~
*.sw[po]
.*.sw[po]

# Assistant & internal working artifacts — the public repo carries none of these
CLAUDE.md
AGENTS.md
.claude/
.specs/

# Local scratch that may hold real data during debugging
inbox/
debug/

# Statements are user financial data. Make committing one impossible by accident:
# ignore every statement-shaped file, then re-allow ONLY the synthetic test
# fixtures (fabricated data, real layout — see tests/fixtures/README).
# Formats the app can't even parse (.pdf, .ofx, .qif) are ignored too: an
# unusable file is the one most likely to be dropped here and forgotten.
*.csv
*.xls
*.xlsx
*.xlsm
*.pdf
*.ofx
*.qif
!tests/fixtures/**

# Playwright output
test-results/
playwright-report/
